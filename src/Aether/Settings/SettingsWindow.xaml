<Window x:Class="Aether.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aether Desktop · 设置" Width="940" Height="620" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="Margin" Value="4,22,0,10" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,6" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Background="#33000000" />
        <DockPanel Margin="18,16,14,18">
            <StackPanel DockPanel.Dock="Top" Margin="6,2,0,22">
                <TextBlock Text="A E T H E R" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="DESKTOP  ·  1.0" FontSize="10" Foreground="{StaticResource FaintTextBrush}" Margin="1,4,0,0" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" CornerRadius="12" Padding="14,12" Margin="0,12,0,0"
                    Background="{DynamicResource AccentFaintBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="让桌面回归安静。" FontSize="13" />
                    <TextBlock Text="A calmer desktop." FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel>
                <RadioButton x:Name="NavLook" Style="{StaticResource NavItem}" Tag="&#xE790;" Content="外观与颜色" IsChecked="True" Checked="OnNav" />
                <RadioButton x:Name="NavWidgets" Style="{StaticResource NavItem}" Tag="&#xF0E2;" Content="桌面组件" Checked="OnNav" />
                <RadioButton x:Name="NavIsland" Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="灵动岛" Checked="OnNav" />
                <RadioButton x:Name="NavDock" Style="{StaticResource NavItem}" Tag="&#xE8A9;" Content="Dock 与抽屉" Checked="OnNav" />
                <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="关于" Checked="OnNav" />
            </StackPanel>
        </DockPanel>

        <!-- Caption buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                    WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="2">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" />
            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" />
        </StackPanel>

        <!-- Pages -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,44,0,0" Padding="34,0,34,30">
            <Grid>
                <!-- ============ Appearance ============ -->
                <StackPanel x:Name="PageLook">
                    <TextBlock Text="外观与颜色" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="组件的颜色跟着桌面走，或者由你自己决定。" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="主题颜色" />
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="ModeManual" Style="{StaticResource Chip}" Content="手动取色" GroupName="mode" Checked="OnModeChanged" />
                                <RadioButton x:Name="ModeAuto" Style="{StaticResource Chip}" Content="自动跟随壁纸" GroupName="mode" Checked="OnModeChanged" />
                                <RadioButton x:Name="ModeFixed" Style="{StaticResource Chip}" Content="固定颜色" GroupName="mode" Checked="OnModeChanged" />
                            </WrapPanel>
                            <TextBlock x:Name="ModeHint" Style="{StaticResource RowHint}" Margin="2,2,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentBrush}"
                                        BorderBrush="#40FFFFFF" BorderThickness="2" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ColorValue" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" />
                                    <TextBlock x:Name="ColorSource" Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <Button x:Name="PickButton" Grid.Column="2" Style="{StaticResource AccentButton}" Click="OnPick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEF3C;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                                        <TextBlock Text="从桌面取色" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel x:Name="FixedPanel" Margin="0,16,0,0">
                                <TextBlock Text="选择颜色" FontSize="13" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8" />
                                <WrapPanel x:Name="Swatches" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBox x:Name="HexBox" Style="{StaticResource HexBox}" Width="120" KeyDown="OnHexKey" />
                                    <Button Style="{StaticResource GhostButton}" Content="使用此颜色" Margin="8,0,0,0" Click="OnHexApply" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="玻璃效果" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Margin="0,12,0,4">
                                <TextBlock Style="{StaticResource RowLabel}" Text="玻璃色调" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <RadioButton x:Name="ToneLight" Style="{StaticResource Chip}" Content="浅色毛玻璃" GroupName="tone" Click="OnToneChanged" />
                                    <RadioButton x:Name="ToneDark" Style="{StaticResource Chip}" Content="深色烟熏玻璃" GroupName="tone" Click="OnToneChanged" />
                                </WrapPanel>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="卡片浓度" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="越低越通透，越高文字越清楚" />
                                </StackPanel>
                                <Slider x:Name="GlassSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnGlassChanged" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="背景模糊" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="卡片后面的壁纸变模糊（毛玻璃）" />
                                </StackPanel>
                                <CheckBox x:Name="BlurSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnBlurChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Widgets ============ -->
                <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                    <TextBlock Text="桌面组件" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="组件可以在桌面上随意拖动；右键组件也能快速修改。" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="组件" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="WidgetToggles" />
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="时钟" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="显示时钟" />
                                <CheckBox x:Name="ClockVisible" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnClockVisible" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <StackPanel Margin="0,12,0,4">
                                <TextBlock Style="{StaticResource RowLabel}" Text="样式" Margin="0,0,0,10" />
                                <WrapPanel x:Name="ClockStyles" />
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="大小" />
                                <Slider x:Name="ClockScale" Grid.Column="1" Minimum="0.6" Maximum="2.2" VerticalAlignment="Center" ValueChanged="OnClockScale" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="24 小时制" />
                                <CheckBox x:Name="Clock24" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnClockOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="显示秒" />
                                <CheckBox x:Name="ClockSeconds" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnClockOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="显示日期" />
                                <CheckBox x:Name="ClockDate" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnClockOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="玻璃卡片背景" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="关闭时文字直接浮在壁纸上" />
                                </StackPanel>
                                <CheckBox x:Name="ClockCard" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnClockOption" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="布局" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="锁定所有组件位置" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="锁定后不能拖动，避免误碰" />
                                </StackPanel>
                                <CheckBox x:Name="LockSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnLock" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="组件跑到屏幕外了？" />
                                <Button Style="{StaticResource GhostButton}" Content="重置组件位置" HorizontalAlignment="Right" Click="OnResetPositions" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Island ============ -->
                <StackPanel x:Name="PageIsland" Visibility="Collapsed">
                    <TextBlock Text="灵动岛" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="平时缩在屏幕顶部，有事才展开。" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="基本" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="显示灵动岛" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="鼠标移上去展开；按住左右拖可以换位置" />
                                </StackPanel>
                                <CheckBox x:Name="IslandEnabled" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="窗口最大化时缩成细线" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="默认关闭：最大化时灵动岛照常显示，可以拖文件进去。打开后缩成细线、不挡浏览器标签页，鼠标碰顶边再展开。全屏游戏时总是完全隐藏" />
                                </StackPanel>
                                <CheckBox x:Name="IslandThinLine" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="位置" />
                                <Button Style="{StaticResource GhostButton}" Content="回到正中间" HorizontalAlignment="Right" Click="OnIslandCenter" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="外观" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Margin="0,12,0,4">
                                <TextBlock Style="{StaticResource RowLabel}" Text="形态" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <RadioButton x:Name="ShapeNotch" Style="{StaticResource Chip}" Content="刘海（贴顶边）" GroupName="ishape" Click="OnIslandOption" />
                                    <RadioButton x:Name="ShapeCapsule" Style="{StaticResource Chip}" Content="悬浮胶囊" GroupName="ishape" Click="OnIslandOption" />
                                </WrapPanel>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <StackPanel Margin="0,12,0,4">
                                <TextBlock Style="{StaticResource RowLabel}" Text="皮肤" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <RadioButton x:Name="SkinBlack" Style="{StaticResource Chip}" Content="经典黑" GroupName="iskin" Click="OnIslandOption" />
                                    <RadioButton x:Name="SkinCover" Style="{StaticResource Chip}" Content="随封面变色" GroupName="iskin" Click="OnIslandOption" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource RowHint}" Text="随封面变色：放歌时底色和光晕取自专辑封面，展开后光晕跟着鼠标走" Margin="0,0,0,8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="收起时显示" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="时间（没放歌时）" />
                                <CheckBox x:Name="IslandTime" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="TimeSimple" Style="{StaticResource Chip}" Content="简约" GroupName="itime" Click="OnIslandOption" />
                                <RadioButton x:Name="TimeSeg" Style="{StaticResource Chip}" Content="数码管" GroupName="itime" Click="OnIslandOption" />
                                <RadioButton x:Name="TimeSerif" Style="{StaticResource Chip}" Content="衬线斜体" GroupName="itime" Click="OnIslandOption" />
                            </WrapPanel>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="单行歌词（放歌时）" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="没有歌词时显示歌名" />
                                </StackPanel>
                                <CheckBox x:Name="IslandLyrics" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="未读消息红点" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="微信、QQ 等程序闪烁提醒时亮图标；点一下直接打开。不读取任何消息内容" />
                                </StackPanel>
                                <CheckBox x:Name="IslandUnread" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource RowLabel}" Text="系统读数" />
                                <CheckBox x:Name="IslandStats" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox x:Name="StatCpu" Content="CPU" Style="{StaticResource ToggleChip}" Click="OnIslandOption" />
                                <CheckBox x:Name="StatMem" Content="内存" Style="{StaticResource ToggleChip}" Click="OnIslandOption" />
                                <CheckBox x:Name="StatNet" Content="网速" Style="{StaticResource ToggleChip}" Click="OnIslandOption" />
                                <CheckBox x:Name="StatBat" Content="电量" Style="{StaticResource ToggleChip}" Click="OnIslandOption" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="显示内容" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="音乐频谱" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="真实系统声音的频谱；只在有声音时运行" />
                                </StackPanel>
                                <CheckBox x:Name="IslandSpectrum" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="声音来源图标" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="哪个程序正在发声，就显示它的图标" />
                                </StackPanel>
                                <CheckBox x:Name="IslandSources" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="切歌时弹出歌曲信息" />
                                <CheckBox x:Name="IslandToast" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="调音量时显示提示" />
                                <CheckBox x:Name="IslandVolume" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="调亮度时显示提示" />
                                <CheckBox x:Name="IslandBrightness" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="系统通知" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="把 Windows 通知（QQ、邮件、浏览器…）显示在灵动岛上。想只看灵动岛的，可以打开 Windows 的「勿扰」，通知仍会出现在这里" />
                                </StackPanel>
                                <CheckBox x:Name="IslandNotify" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="显示通知内容" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="显示标题和正文，可复制、点开对应软件；关闭后只提示「来源 · 新消息」。Windows 自己的系统提示始终不显示" />
                                </StackPanel>
                                <CheckBox x:Name="IslandNotifyBody" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="充电与低电量提示" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="插拔电源时、电量降到 20% 和 10% 时弹出" />
                                </StackPanel>
                                <CheckBox x:Name="IslandPower" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="在线歌词" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="从开放歌词库 LRCLIB 获取，只发送歌名、歌手和时长；歌词缓存在 Data\Lyrics" />
                                </StackPanel>
                                <CheckBox x:Name="IslandOnlineLyrics" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="置物架与剪贴板" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="记录剪贴板" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="最近 30 条（固定的另算），只存在本机 Data\clipboard.json；密码管理器标记为敏感的内容不会记录。文件拖到灵动岛上即可放进置物架" />
                                </StackPanel>
                                <CheckBox x:Name="IslandClipboard" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="也记录复制的图片" />
                                <CheckBox x:Name="IslandClipboardImages" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="截图自动放进置物架" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="Win+Shift+S / PrtSc 截完图存成文件放上置物架，可直接拖进微信；7 天后不在置物架上的自动清理" />
                                </StackPanel>
                                <CheckBox x:Name="IslandScreenshotShelf" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="AI 额度" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="显示 Claude / Codex 额度" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="读取本机已登录的 Claude Code / Claude 桌面版 / Codex，只向它们自己的官方接口查询用量；登录信息不保存、不外传。最多 5 分钟查一次" />
                                </StackPanel>
                                <CheckBox x:Name="IslandQuota" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="收起时显示最高用量" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="例如「Claude 63%」，每 5 分钟更新" />
                                </StackPanel>
                                <CheckBox x:Name="IslandQuotaCompact" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="流光与动效" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="GlowBox" Margin="0,6,0,6" />
                    </Border>

                    <TextBlock x:Name="MailSection" Style="{StaticResource SectionTitle}" Text="邮件与验证码" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="收邮件" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="只读方式收信（不会把邮件标成已读）；授权码用 Windows 账户加密保存在 Data\mail.json" />
                                </StackPanel>
                                <CheckBox x:Name="IslandMail" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="收到验证码时弹出" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="灵动岛显示「验证码 384920」，移上去点一下即可复制" />
                                </StackPanel>
                                <CheckBox x:Name="IslandMailCode" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnIslandOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="验证码自动隐藏" />
                                <StackPanel x:Name="MailHideChoices" Orientation="Horizontal" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel x:Name="MailAccountsBox" Margin="0,4,0,12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Dock ============ -->
                <StackPanel x:Name="PageDock" Visibility="Collapsed">
                    <TextBlock Text="Dock 与抽屉" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="替代任务栏的底部 Dock，以及自动分类的应用抽屉。" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="基本" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="显示 Dock" />
                                <CheckBox x:Name="DockEnabled" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnDockOption" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="隐藏 Windows 任务栏" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="由 Dock 代替；退出 Aether 时自动恢复原样" />
                                </StackPanel>
                                <CheckBox x:Name="DockHideTaskbar" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnDockOption" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <StackPanel Margin="0,12,0,4">
                                <TextBlock Style="{StaticResource RowLabel}" Text="自动隐藏" />
                                <TextBlock x:Name="HideHint" Style="{StaticResource RowHint}" Margin="0,3,0,10" />
                                <WrapPanel>
                                    <RadioButton x:Name="HideSmart" Style="{StaticResource Chip}" Content="智能（被窗口挡住时）" GroupName="dockhide" Click="OnDockOption" />
                                    <RadioButton x:Name="HideAlways" Style="{StaticResource Chip}" Content="总是隐藏" GroupName="dockhide" Click="OnDockOption" />
                                    <RadioButton x:Name="HideNever" Style="{StaticResource Chip}" Content="一直显示" GroupName="dockhide" Click="OnDockOption" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="外观" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="图标大小" />
                                <Slider x:Name="DockIconSize" Grid.Column="1" Minimum="28" Maximum="64" VerticalAlignment="Center" ValueChanged="OnDockSlider" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="显示外框" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="关闭后没有玻璃底板，图标直接浮在桌面上（和无框卡片一样）" />
                                </StackPanel>
                                <CheckBox x:Name="DockFrame" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnDockOption" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="外框大小" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="图标和外框之间的留白，和图标大小分开调" />
                                </StackPanel>
                                <Slider x:Name="DockFramePad" Grid.Column="1" Minimum="0" Maximum="28" VerticalAlignment="Center" ValueChanged="OnDockSlider" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="玻璃浓度" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="0 = 几乎全透明" />
                                </StackPanel>
                                <Slider x:Name="DockOpacity" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnDockSlider" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="背景模糊" />
                                <CheckBox x:Name="DockBlur" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnDockOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="鼠标经过放大" />
                                <CheckBox x:Name="DockMagnify" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnDockOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="显示名称提示" />
                                <CheckBox x:Name="DockLabels" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnDockOption" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="显示正在运行的程序" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="没固定的程序打开时也出现在 Dock 上" />
                                </StackPanel>
                                <CheckBox x:Name="DockRunning" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnDockOption" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="应用抽屉" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                        <Grid Margin="0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Text="应用和分组" />
                                <TextBlock x:Name="DrawerInfo" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="打开抽屉" HorizontalAlignment="Right" Click="OnOpenDrawer" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Text="抽屉浓度" />
                                <TextBlock Style="{StaticResource RowHint}" Text="0 = 全透明，只剩模糊（关掉模糊就完全透明）" />
                            </StackPanel>
                            <Slider x:Name="DrawerOpacity" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnDockSlider" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                        <Grid Margin="0,12">
                            <TextBlock Style="{StaticResource RowLabel}" Text="抽屉背景模糊" />
                            <CheckBox x:Name="DrawerBlur" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnDockOption" />
                        </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ About ============ -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="关于" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="启动" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Margin="0,12">
                                <TextBlock Style="{StaticResource RowLabel}" Text="开机自动启动" />
                                <TextBlock x:Name="AutostartHint" Style="{StaticResource RowHint}" Margin="0,2,0,10" />
                                <WrapPanel>
                                    <RadioButton x:Name="AutoHigh" Style="{StaticResource Chip}" Content="高 · 登录后立即" GroupName="autostart" Click="OnAutostart" />
                                    <RadioButton x:Name="AutoNormal" Style="{StaticResource Chip}" Content="普通 · Windows 启动项" GroupName="autostart" Click="OnAutostart" />
                                    <RadioButton x:Name="AutoLow" Style="{StaticResource Chip}" Content="低 · 延迟 60 秒" GroupName="autostart" Click="OnAutostart" />
                                    <RadioButton x:Name="AutoOff" Style="{StaticResource Chip}" Content="关闭" GroupName="autostart" Click="OnAutostart" />
                                </WrapPanel>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" />
                            <Grid Margin="0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="游戏 / 全屏时让路" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="全屏程序在前台时自动：隐藏灵动岛和 Dock、暂停卡片刷新和音频采集、降低 Aether 的 CPU 优先级（始终开启）" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="Aether Desktop" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource RowHint}" Text="所有设置保存在程序旁边的 Data 文件夹里，整个文件夹可以直接拷走。" Margin="0,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="打开 Data 文件夹" Click="OnOpenData" />
                                <Button Style="{StaticResource GhostButton}" Content="退出 Aether" Margin="10,0,0,0" Click="OnQuit" />
                                <Button Style="{StaticResource GhostButton}" Content="卸载…" Margin="10,0,0,0" Click="OnUninstall" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="更新" />
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,2,140,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="UpdateCheck" Style="{StaticResource GhostButton}" Content="检查更新" Click="OnCheckUpdate" />
                                    <Button x:Name="UpdateInstall" Style="{StaticResource AccentButton}" Content="更新并重启" Margin="8,0,0,0" Click="OnInstallUpdate" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="UpdateNotes" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                            <Grid Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="自动检查新版本" />
                                <CheckBox x:Name="UpdateAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnUpdateAuto" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
